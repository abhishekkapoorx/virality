PORT=4000

# Clerk — same secret as web; JWT verification on /v1/me/*
CLERK_SECRET_KEY=sk_test_replace_me
# Webhook signing secret (Clerk Dashboard → Webhooks → Signing secret). NOT the same as CLERK_SECRET_KEY.
# Docker dev: https://<NGROK_DOMAIN>/v1/webhooks/clerk — or set explicit URL:
# CLERK_WEBHOOK_URL=https://werewolf-refined-urgently.ngrok-free.app/v1/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me

# Fallback when CLERK_SECRET_KEY is unset (local dev without sign-in)
DEMO_USER_ID=demo-user

# Postgres — use same DB name/user/password as Docker Compose (root .env / POSTGRES_*).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linkedin_agent

# Redis — local dev with `docker compose up redis` (or full stack).
REDIS_URL=redis://localhost:6379
# Telegram Bot API — MVP draft loop channel
TELEGRAM_BOT_TOKEN=
# Optional: setWebhook secret_token (sent as X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
# Public API base for scripts/set-telegram-webhook.ts (e.g. ngrok URL)
# WEBHOOK_BASE_URL=https://your-subdomain.ngrok-free.app

# Legacy Slack stubs (not MVP)
SLACK_SIGNING_SECRET=replace_me
SLACK_BOT_TOKEN=replace_me
