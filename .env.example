# Docker Compose defaults for Postgres + Redis (see docker-compose.yml).
POSTGRES_DB=linkedin_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379

# App ports when running api / web / worker in Docker.
WEB_PORT=3000
API_PORT=4000
WORKER_PORT=4010

# ngrok (docker-compose.dev.yml — required for `pnpm docker:dev`)
# Get token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=<YOUR_NGROK_AUTHTOKEN>
NGROK_DOMAIN=<YOUR_NGROK_DOMAIN>
NGROK_INSPECT_PORT=4040

# Clerk webhook URL when using docker:dev ngrok:
# https://${NGROK_DOMAIN}/v1/webhooks/clerk

# Optional: copy into api/.env and worker/.env for host-side dev (pnpm dev) with Compose DB/cache up.
# Matches docker-compose internal URLs when services talk to host — use localhost + ports above.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linkedin_agent
REDIS_URL=redis://localhost:6379
