{
  "name": "linkedin-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Slack-first LinkedIn drafting agent monorepo",
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "predev": "pnpm --filter @linkedin-agent/shared build",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "docker:up": "docker compose up --build",
    "docker:prod": "docker compose up --build",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build --watch",
    "docker:down": "docker compose down",
    "ngrok:webhook": "ngrok http 4000"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "typescript-eslint": "^8.15.0"
  }
}
